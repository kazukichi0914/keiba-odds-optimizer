{
  "manifest_version": 3,
  "name": "重賞 ワイド買い目アドバイザー",
  "version": "0.1.0",
  "description": "netkeiba のオッズと競馬ラボの予想印から、予算内で当たりやすくトリガミのない買い目を提案します。",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://race.netkeiba.com/*",
    "https://www.keibalab.jp/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}